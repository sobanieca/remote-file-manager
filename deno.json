{
  "name": "@sobanieca/remote-file-manager",
  "version": "0.10.1",
  "license": "MIT",
  "exports": "./src/main.js",
  "tasks": {
    "dev": "cd test && RFM_DEV_UI_ORIGIN=http://localhost:4507 deno run -A ../src/main.js --port 8000",
    "ui": "cd ui && imp start --env dev",
    "build-ui": "cd ui && imp build --env prod && cd .. && deno run --allow-read --allow-write scripts/bundle-ui.js"
  },
  "fmt": {
    "exclude": [
      "ui/",
      "src/ui-assets.js"
    ]
  },
  "lint": {
    "exclude": [
      "ui/",
      "src/ui-assets.js"
    ]
  },
  "publish": {
    "exclude": [
      "ui/"
    ]
  }
}
